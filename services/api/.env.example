ENV=dev
DEBUG=true

# 数据库
# 不需要保存对话时保持 false；本地或部署环境有 PostgreSQL 时改为 true
PERSISTENCE_ENABLED=false
DATABASE_URL=postgresql+psycopg://yewne:yewne_dev_password@localhost:5432/yewne_dev
DATABASE_HEALTH_TIMEOUT_SECONDS=2

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
# 默认 mock，离线/无 key 也能跑 demo；要接真模型改成 "deepseek" 并填 DEEPSEEK_API_KEY
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

DOUBAO_API_KEY=

# 豆包 TTS（seed-tts-2.0，火山引擎 V3）
# voice ID 在控制台「音色管理」查，2.0 后缀为 _uranus_bigtts
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE=zh_female_xiaohe_uranus_bigtts
DOUBAO_TTS_PITCH=-2.0

# STT（语音转文字）
# 默认 mock（返回固定句子，不能识别真说话）；要真识别请二选一：
#   A) Web Demo：用 Chrome，前端会自动走浏览器语音识别（无需 key）
#   B) 后端真 STT：改成 whisper 并填 key（推荐硅基流动 SenseVoice，中文更好）
STT_PROVIDER=mock
STT_TIMEOUT_SECONDS=30
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.siliconflow.cn/v1
WHISPER_MODEL=FunAudioLLM/SenseVoiceSmall

# TTS（文字转语音）
# 两种选择：
#   A) SiliconFlow（推荐）：TTS_PROVIDER=siliconflow，复用上面的 WHISPER_API_KEY，不需要额外 key
#   B) MiniMax：TTS_PROVIDER=minimax，需要填 MINIMAX_API_KEY + MINIMAX_GROUP_ID
TTS_PROVIDER=mock
TTS_TIMEOUT_SECONDS=60

# SiliconFlow TTS — 复用 WHISPER_API_KEY，无需额外配置
# 可选声音：anna / bella / claire / david / alex / benjamin / diana
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna
SILICONFLOW_TTS_SPEED=1.0

# MiniMax TTS
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=female-tianmei
MINIMAX_TTS_SPEED=0.92

# 阿里云内容安全
SAFETY_PROVIDER=mock
SAFETY_TIMEOUT_SECONDS=10
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SAFETY_BASE_URL=https://green-cip.cn-hangzhou.aliyuncs.com
ALIYUN_SAFETY_API_VERSION=2022-03-02
# ⚠️ 必须用 ugc_moderation_byllm_pro(config 默认)。comment_detection_pro 实测会放行
# 自杀危机文本(2026-07-17 用真实 key 验证),不能用于本产品。
ALIYUN_SAFETY_SERVICE=ugc_moderation_byllm_pro
ALIYUN_REGION_ID=cn-hangzhou
