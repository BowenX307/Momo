ENV=dev
DEBUG=true

# 数据库
DATABASE_URL=postgresql+psycopg://momo:momo@localhost:5432/momo

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
# 默认 mock，离线/无 key 也能跑 demo；要接真模型改成 "deepseek" 并填 DEEPSEEK_API_KEY
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

DOUBAO_API_KEY=

# 阿里云内容安全
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
